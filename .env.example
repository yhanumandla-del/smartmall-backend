# Copy these into your hosting dashboard (Railway, Render, etc.) or your shell.
# Never commit real values.

# Port is normally set by the host
PORT=8080

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/smartmall?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=root
DB_PASSWORD=change-me

# Long random string used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:*,https://your-frontend.netlify.app
